{
  "name": "keel",
  "version": "1.0.0",
  "private": true,
  "description": "A personal life OS: money, work, habits, health, tasks and notes in one offline-first place.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:core": "node --test \"test/!(e2e|build).test.mjs\"",
    "serve": "node serve.mjs",
    "start": "node build.mjs && node serve.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
